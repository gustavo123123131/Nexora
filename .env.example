# Configurar no painel da Vercel (Settings > Environment Variables).
# Não enviar credenciais reais ao GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEXORA_ACCESS_PASSWORD=USE_UMA_SENHA_FORTE_COM_PELO_MENOS_12_CARACTERES
NEXORA_SESSION_SECRET=USE_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
