# O modo padrão da Vercel não exige NENHUMA variável de ambiente.
# Sites e perfis ficam neste navegador (localStorage), sem senha.
# Abaixo SOMENTE para o modo opcional ?storage=cloud com PostgreSQL:
# NÃO envie valores reais ao GitHub.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# NEXORA_ACCESS_PASSWORD=ESCOLHA_UMA_SENHA_COM_PELO_MENOS_12_CARACTERES
# NEXORA_SESSION_SECRET=SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
