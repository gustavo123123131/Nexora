# NEVER commit local sessions, credentials or Chromium profiles
/data/
.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.vercel/
*.log

# Windows executor: never publish private key, cookies, sessions, venv or logs
/runner/private/
/runner/data/
/runner/.venv-windows/
/runner/.venv-runner/
/runner/*.exe
